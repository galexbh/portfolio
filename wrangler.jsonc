{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galexbh-portfolio",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // Reemplaza un rate limit anterior sobre KV — no era atómico y, al ser KV
  // de consistencia eventual entre colos, tardaba casi la ventana completa
  // en propagar un contador (ver comentario en src/pages/api/track.ts). Ese
  // namespace (KV_RATE_LIMIT) ya se borró de Cloudflare, confirmado en producción.
  "ratelimits": [
    {
      "name": "CV_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
