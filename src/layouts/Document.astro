---
import '../styles/global.css';
import '../styles/cv.css';
import SeoHead from '../components/SeoHead.astro';
import { getMeta, getEducation, getExperience, getCertifications } from '../lib/keystatic-content';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const meta = await getMeta();
const education = await getEducation();
const experience = await getExperience();
const certifications = await getCertifications();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const currentRole = experience.find((role) => role.current);

const hasCredential = certifications
  .filter((c) => c.credentialUrl)
  .map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: c.name,
    url: c.credentialUrl,
  }));

const sameAs = [meta.github, meta.site.linkedin, meta.site.instagram, meta.site.youtube].filter(
  (url): url is string => Boolean(url)
);

// Extiende el ProfilePage/Person de Base.astro con los datos propios de un CV:
// título obtenido, empleador actual (worksFor) y credenciales (hasCredential),
// útiles para rich results y ATS que leen JSON-LD.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonicalURL.toString(),
  inLanguage: 'es',
  mainEntity: {
    '@type': 'Person',
    name: meta.name,
    url: canonicalURL.toString(),
    jobTitle: meta.role,
    email: meta.email,
    telephone: meta.phone,
    address: {
      '@type': 'Place',
      name: meta.location,
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: education.institution,
    },
    ...(currentRole ? { worksFor: { '@type': 'Organization', name: currentRole.company } } : {}),
    ...(hasCredential.length ? { hasCredential } : {}),
    sameAs,
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      authorName={meta.name}
      imageAlt={`${meta.name} — CV`}
      type="profile"
      robotsNoIndex
    />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
