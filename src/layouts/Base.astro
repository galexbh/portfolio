---
import '../styles/global.css';
import { getMeta } from '../lib/keystatic-content';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const meta = await getMeta();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image ?? '/img/og-cover.jpg', Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonicalURL.toString(),
  inLanguage: 'es',
  mainEntity: {
    '@type': 'Person',
    name: meta.name,
    url: canonicalURL.toString(),
    jobTitle: meta.role,
    address: {
      '@type': 'Place',
      name: meta.location,
    },
    sameAs: [meta.github],
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={meta.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:locale" content="es_HN" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${meta.name}, ${meta.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={`${meta.name}, ${meta.role}`} />

    <link rel="preload" href="/fonts/overpass-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jbm-500.woff2" as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <slot />
    <script src="/scripts/reveal.js" is:inline></script>
  </body>
</html>
