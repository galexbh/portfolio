---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { getMeta } from '../lib/keystatic-content';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const meta = await getMeta();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonicalURL.toString(),
  inLanguage: 'es',
  mainEntity: {
    '@type': 'Person',
    name: meta.name,
    url: canonicalURL.toString(),
    jobTitle: meta.role,
    address: {
      '@type': 'Place',
      name: meta.location,
    },
    sameAs: [meta.github],
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      authorName={meta.name}
      imageAlt={`${meta.name}, ${meta.role}`}
      image={image}
    />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <slot />
    <script src="/scripts/reveal.js" is:inline></script>
  </body>
</html>
