---
import { getHero, getCapabilityNodes, getMeta } from '../lib/keystatic-content';

const [hero, capabilityNodes, meta] = await Promise.all([getHero(), getCapabilityNodes(), getMeta()]);

const root = { x: 110, y: 300 };
const radius = 250;
const angles = [-70, -35, 0, 35, 70];
const nodes = capabilityNodes.map((node, i) => {
  const rad = (angles[i] * Math.PI) / 180;
  return {
    ...node,
    x: root.x + radius * Math.cos(rad),
    y: root.y + radius * Math.sin(rad),
  };
});
---

<header id="top" class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy reveal">
      <h1 class="hero-title">{hero.headline}</h1>
      <p class="hero-sub">{hero.subheadline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
      <p class="hero-meta mono">
        <span class="status-dot" aria-hidden="true"></span>
        {meta.location} · uptime desde 2023
      </p>
    </div>

    <div class="hero-graph reveal" aria-hidden="true">
      <div
        class="graph-3d"
        data-graph-3d
        data-nodes={JSON.stringify(nodes.map((n) => ({ label: n.label, detail: n.detail })))}
      >
        <div class="graph-3d-root">
          <img src="/img/hero-portrait.webp" alt="" width="92" height="92" />
        </div>
        <p class="graph-3d-root-label mono">{meta.handle}</p>
      </div>
      <svg viewBox="0 0 460 600" class="graph-svg" role="img" aria-label="Mapa de topología de capacidades de Gabriel Barrientos">
        <defs>
          <clipPath id="avatarClip">
            <circle cx={root.x} cy={root.y} r="46" />
          </clipPath>
        </defs>

        {nodes.map((node, i) => (
          <line
            x1={root.x}
            y1={root.y}
            x2={node.x}
            y2={node.y}
            class="edge"
            style={`--delay: ${i * 0.15}s`}
          />
        ))}

        <image
          href="/img/hero-portrait.webp"
          x={root.x - 46}
          y={root.y - 46}
          width="92"
          height="92"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#avatarClip)"
        />
        <circle cx={root.x} cy={root.y} r="46" class="root-ring" />
        <text x={root.x} y={root.y + 74} text-anchor="middle" class="node-label root-label mono">
          {meta.handle}
        </text>

        {nodes.map((node) => {
          const align = node.x > root.x + 40 ? 'start' : node.x < root.x - 40 ? 'end' : 'middle';
          const labelX = node.x + (align === 'start' ? 16 : align === 'end' ? -16 : 0);
          return (
            <g class="node">
              <circle cx={node.x} cy={node.y} r="8" class="node-dot" />
              <circle cx={node.x} cy={node.y} r="15" class="node-halo" />
              <text x={labelX} y={node.y - 4} text-anchor={align} class="node-label mono">
                {node.label}
              </text>
              <text x={labelX} y={node.y + 12} text-anchor={align} class="node-detail mono">
                {node.detail}
              </text>
            </g>
          );
        })}
      </svg>
    </div>
  </div>
</header>

<script>
  // Guards against the 3D scene ever activating (or the SVG ever being hidden)
  // more than once per page load, no matter how boot()/run() end up invoked —
  // defense in depth on top of the {once:true} listener below.
  let started = false;
  let active = false;

  async function boot() {
    const heroGraph = document.querySelector<HTMLElement>('.hero-graph');
    const mount = document.querySelector<HTMLElement>('[data-graph-3d]');
    const svg = document.querySelector<SVGElement>('.graph-svg');
    if (!heroGraph || !mount || !svg) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.innerWidth < 900) return;

    const probe = document.createElement('canvas');
    if (!probe.getContext('webgl2')) return;
    if ((navigator.hardwareConcurrency ?? 4) < 4) return;

    const raw = mount.dataset.nodes;
    if (!raw) return;
    let nodes: { label: string; detail: string }[];
    try {
      nodes = JSON.parse(raw);
    } catch {
      return;
    }

    // Imperative, unconditional show/hide — not just a CSS class toggle — so
    // there is no timing window in which both the SVG fallback and the 3D
    // scene can be visible at once, regardless of how/when this fires.
    // display:none (not a fading opacity) so the swap is instantaneous: the
    // 3D scene already has a real painted frame by the time this runs (two
    // rAFs after init), so there's nothing to crossfade — a fade here only
    // ever bought a ~400ms window where both layers sat on top of each other
    // at full opacity, which is what actually looked like a rendering bug.
    const setActive = (next: boolean) => {
      active = next;
      heroGraph.classList.toggle('graph-3d-active', next);
      svg.style.display = next ? 'none' : '';
    };

    const run = async () => {
      if (started) return;
      started = true;
      const { initHeroGraph3D } = await import('../scripts/hero-graph-3d');
      if (active) return; // guard against a duplicate run() resolving twice
      const onFail = () => setActive(false);
      const dispose = initHeroGraph3D(mount, nodes, onFail);
      if (dispose) {
        // Wait two frames past a real render before swapping, so we never hide
        // the SVG in favor of a canvas that hasn't actually painted anything.
        requestAnimationFrame(() => requestAnimationFrame(() => {
          setActive(true);
        }));
      }
    };

    const startWhenVisible = () => {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          run();
        }
      });
      io.observe(heroGraph);
    };

    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(startWhenVisible, { timeout: 500 });
    } else {
      setTimeout(startWhenVisible, 200);
    }
  }

  if (document.readyState === 'complete') {
    boot();
  } else {
    window.addEventListener('load', boot, { once: true });
  }
</script>

<style>
  .hero {
    padding-top: 160px;
    padding-bottom: 96px;
    overflow: hidden;
    background: url('/img/hero-grid-texture.webp') center top / cover no-repeat;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(320px, 460px) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    order: 2;
  }

  .hero-graph {
    order: 1;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1.8rem + 3.2vw, 4rem);
    line-height: 1.05;
    margin: 0 0 22px;
    max-width: 14ch;
  }

  .hero-sub {
    font-size: clamp(1.02rem, 0.96rem + 0.3vw, 1.2rem);
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 34px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .graph-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .graph-3d {
    display: none;
    position: absolute;
    inset: 0;
  }

  .hero-graph.graph-3d-active {
    position: relative;
    aspect-ratio: 460 / 600;
  }

  .hero-graph.graph-3d-active .graph-3d {
    display: block;
  }

  .hero-graph.graph-3d-active .graph-svg {
    display: none;
  }

  .graph-3d :global(.graph-3d-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .graph-3d-root {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 92px;
    height: 92px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    overflow: hidden;
    z-index: 2;
  }

  .graph-3d-root img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .graph-3d-root-label {
    position: absolute;
    left: 50%;
    top: calc(50% + 58px);
    transform: translate(-50%, 0);
    font-size: 12px;
    color: var(--text-dim);
    z-index: 2;
    white-space: nowrap;
  }

  .graph-3d :global(.graph-3d-label) {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    font-size: 13px;
    color: var(--text);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
    pointer-events: none;
  }

  .graph-3d :global(.graph-3d-label-title) {
    font-weight: 500;
  }

  .graph-3d :global(.graph-3d-label-detail) {
    font-size: 10.5px;
    color: var(--text-faint);
  }

  .edge {
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
    opacity: 0.55;
    stroke-dashoffset: 200;
    animation: draw 1.6s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .root-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-dot {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-halo {
    fill: none;
    stroke: var(--accent-dim);
    stroke-width: 1;
    animation: pulse 3s ease-in-out infinite;
  }

  .node-label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 500;
  }

  .root-label {
    fill: var(--text-dim);
    font-size: 12px;
  }

  .node-detail {
    fill: var(--text-faint);
    font-size: 10.5px;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      r: 15;
    }
    50% {
      opacity: 0;
      r: 24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge {
      animation: none;
      stroke-dashoffset: 0;
    }
    .node-halo {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 120px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-graph {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
