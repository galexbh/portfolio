---
import { getHero, getCapabilityNodes, getMeta } from '../lib/keystatic-content';

const [hero, capabilityNodes, meta] = await Promise.all([getHero(), getCapabilityNodes(), getMeta()]);

const root = { x: 110, y: 300 };
const radius = 250;
const angles = [-70, -35, 0, 35, 70];
const nodes = capabilityNodes.map((node, i) => {
  const rad = (angles[i] * Math.PI) / 180;
  return {
    ...node,
    x: root.x + radius * Math.cos(rad),
    y: root.y + radius * Math.sin(rad),
  };
});
---

<header id="top" class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy reveal">
      <h1 class="hero-title">{hero.headline}</h1>
      <p class="hero-sub">{hero.subheadline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
      <p class="hero-meta mono">
        <span class="status-dot" aria-hidden="true"></span>
        {meta.location} · uptime desde 2023
      </p>
    </div>

    <div class="hero-graph reveal" aria-hidden="true">
      <div
        class="graph-3d"
        data-graph-3d
        data-nodes={JSON.stringify(nodes.map((n) => ({ label: n.label, detail: n.detail, x: n.x, y: n.y })))}
      >
      </div>
      <svg viewBox="0 0 460 600" class="graph-svg" role="img" aria-label="Mapa de topología de capacidades de Gabriel Barrientos">
        <defs>
          <clipPath id="avatarClip">
            <circle cx={root.x} cy={root.y} r="46" />
          </clipPath>
        </defs>

        {nodes.map((node, i) => (
          <line
            x1={root.x}
            y1={root.y}
            x2={node.x}
            y2={node.y}
            class="edge graph-svg-enhanced"
            style={`--delay: ${i * 0.15}s`}
          />
        ))}

        <image
          href="/img/hero-portrait.webp"
          x={root.x - 46}
          y={root.y - 46}
          width="92"
          height="92"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#avatarClip)"
        />
        <circle cx={root.x} cy={root.y} r="46" class="root-ring" />
        <text x={root.x} y={root.y + 74} text-anchor="middle" class="node-label root-label mono">
          {meta.handle}
        </text>

        {nodes.map((node) => {
          const align = node.x > root.x + 40 ? 'start' : node.x < root.x - 40 ? 'end' : 'middle';
          const labelX = node.x + (align === 'start' ? 16 : align === 'end' ? -16 : 0);
          return (
            <g class="node">
              <circle cx={node.x} cy={node.y} r="8" class="node-dot graph-svg-enhanced" />
              <circle cx={node.x} cy={node.y} r="15" class="node-halo graph-svg-enhanced" />
              <text x={labelX} y={node.y - 4} text-anchor={align} class="node-label mono">
                {node.label}
              </text>
              <text x={labelX} y={node.y + 12} text-anchor={align} class="node-detail mono">
                {node.detail}
              </text>
            </g>
          );
        })}
      </svg>
    </div>
  </div>
</header>

<script>
  function boot() {
    const heroGraph = document.querySelector<HTMLElement>('.hero-graph');
    const mount = document.querySelector<HTMLElement>('[data-graph-3d]');
    if (!heroGraph || !mount) return;

    const raw = mount.dataset.nodes;
    if (!raw) return;
    let nodes: { label: string; detail: string; x: number; y: number }[];
    try {
      nodes = JSON.parse(raw);
    } catch {
      return;
    }

    const enhancementQuery = window.matchMedia('(min-width: 901px) and (prefers-reduced-motion: no-preference)');
    let disposeCurrent: (() => void) | null = null;
    let starting = false;
    let generation = 0;
    let webglAvailable: boolean | null = null;

    const setActive = (next: boolean) => {
      heroGraph.classList.toggle('graph-3d-active', next);
    };

    const canUseWebGL = () => {
      if (webglAvailable !== null) return webglAvailable;
      const probe = document.createElement('canvas');
      const context = probe.getContext('webgl2');
      webglAvailable = Boolean(context) && (navigator.hardwareConcurrency ?? 4) >= 4;
      context?.getExtension('WEBGL_lose_context')?.loseContext();
      return webglAvailable;
    };

    const stop = () => {
      generation += 1;
      starting = false;
      setActive(false);
      disposeCurrent?.();
      disposeCurrent = null;
    };

    const start = async () => {
      if (starting || disposeCurrent || !enhancementQuery.matches || !canUseWebGL()) return;
      starting = true;
      const runGeneration = ++generation;

      try {
        const { initHeroGraph3D } = await import('../scripts/hero-graph-3d');
        if (runGeneration !== generation || !enhancementQuery.matches) return;

        const dispose = initHeroGraph3D(
          mount,
          nodes,
          () => {
            if (runGeneration === generation && enhancementQuery.matches) setActive(true);
          },
          () => {
            if (runGeneration !== generation) return;
            setActive(false);
            disposeCurrent = null;
          }
        );

        if (!dispose) {
          starting = false;
          return;
        }

        disposeCurrent = dispose;
      } catch {
        if (runGeneration === generation) setActive(false);
      } finally {
        if (runGeneration === generation) starting = false;
      }
    };

    const evaluate = () => {
      if (!enhancementQuery.matches) {
        stop();
        return;
      }
      start();
    };

    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(evaluate, { timeout: 250 });
    } else {
      setTimeout(evaluate, 0);
    }

    enhancementQuery.addEventListener('change', evaluate);
    window.addEventListener('pagehide', stop, { once: true });
  }

  boot();
</script>

<style>
  .hero {
    padding-top: 160px;
    padding-bottom: 96px;
    overflow: hidden;
    background: url('/img/hero-grid-texture.webp') center top / cover no-repeat;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(320px, 460px) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    order: 2;
  }

  .hero-graph {
    order: 1;
    position: relative;
    aspect-ratio: 460 / 600;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1.8rem + 3.2vw, 4rem);
    line-height: 1.05;
    margin: 0 0 22px;
    max-width: 14ch;
  }

  .hero-sub {
    font-size: clamp(1.02rem, 0.96rem + 0.3vw, 1.2rem);
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 34px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .graph-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: 2;
  }

  .graph-3d {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 160ms;
  }

  .hero-graph.graph-3d-active .graph-3d {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .graph-3d :global(.graph-3d-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .graph-svg-enhanced {
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-graph.graph-3d-active .graph-svg-enhanced {
    opacity: 0;
  }

  .hero-graph.graph-3d-active .node-halo {
    animation: none;
  }

  .edge {
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
    opacity: 0.55;
    stroke-dashoffset: 200;
    animation: draw 1.6s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .root-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-dot {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-halo {
    fill: none;
    stroke: var(--accent-dim);
    stroke-width: 1;
    animation: pulse 3s ease-in-out infinite;
  }

  .node-label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 500;
  }

  .root-label {
    fill: var(--text-dim);
    font-size: 12px;
  }

  .node-detail {
    fill: var(--text-faint);
    font-size: 10.5px;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      r: 15;
    }
    50% {
      opacity: 0;
      r: 24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge {
      animation: none;
      stroke-dashoffset: 0;
    }
    .node-halo {
      animation: none;
      opacity: 0;
    }
    .graph-3d {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 120px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-graph {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
