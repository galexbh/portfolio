---
import { getHero, getCapabilityNodes, getMeta } from '../lib/keystatic-content';
import { ROOT, VIEWBOX, NODE_RADIUS, HALO_RADIUS, DRAW_DURATION, STAGGER, PULSE_DURATION, layoutNodes } from '../lib/hero-graph';

const [hero, capabilityNodes, meta] = await Promise.all([getHero(), getCapabilityNodes(), getMeta()]);

const root = ROOT;
const positions = layoutNodes(capabilityNodes.length);
const nodes = capabilityNodes.map((node, i) => ({ ...node, ...positions[i] }));
---

<header id="top" class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy reveal">
      <h1 class="hero-title">{hero.headline}</h1>
      <p class="hero-sub">{hero.subheadline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
      <p class="hero-meta mono">
        <span class="status-dot" aria-hidden="true"></span>
        {meta.location} · uptime desde 2023
      </p>
      <span class="chip visit-chip mono" data-returning-chip hidden>
        <span class="status-dot" aria-hidden="true"></span> sesión reconectada
      </span>
    </div>

    {/* Sin aria-hidden: el SVG de abajo es su propio role="img" + aria-label
       — describe los nodos de capacidad, que son contenido real, no decoración.
       aria-hidden en este wrapper los borraba del árbol de accesibilidad. */}
    <div class="hero-graph reveal" data-pulse-ms={PULSE_DURATION * 1000}>
      <div
        class="graph-3d"
        data-graph-3d
        data-nodes={JSON.stringify(nodes.map((n) => ({ x: n.x, y: n.y })))}
        aria-hidden="true"
      >
      </div>
      <svg
        viewBox={`0 0 ${VIEWBOX.width} ${VIEWBOX.height}`}
        class="graph-svg"
        role="img"
        aria-label="Mapa de topología de capacidades de Gabriel Barrientos"
      >
        <defs>
          <clipPath id="avatarClip">
            <circle cx={root.x} cy={root.y} r="46" />
          </clipPath>
        </defs>

        {nodes.map((node, i) => (
          <line
            x1={root.x}
            y1={root.y}
            x2={node.x}
            y2={node.y}
            class="edge graph-svg-enhanced"
            style={`--delay: ${i * STAGGER}s`}
          />
        ))}

        {/* data-avatar-trigger: gatillo oculto del easter egg (ver <script> más
           abajo). Es el único elemento del grafo que sigue visible e
           interactivo en ambos modos (SVG y 3D) — no lleva graph-svg-enhanced,
           y el SVG completo queda por encima del canvas 3D (z-index). */}
        <g data-avatar-trigger>
          <image
            href="/img/hero-portrait.webp"
            x={root.x - 46}
            y={root.y - 46}
            width="92"
            height="92"
            preserveAspectRatio="xMidYMid slice"
            clip-path="url(#avatarClip)"
          />
          <circle cx={root.x} cy={root.y} r="46" class="root-ring" />
          <text x={root.x} y={root.y + 74} text-anchor="middle" class="node-label root-label mono">
            {meta.handle}
          </text>
        </g>

        {nodes.map((node) => {
          const align = node.x > root.x + 40 ? 'start' : node.x < root.x - 40 ? 'end' : 'middle';
          const labelX = node.x + (align === 'start' ? 16 : align === 'end' ? -16 : 0);
          return (
            <g class="node">
              <circle cx={node.x} cy={node.y} r={NODE_RADIUS} class="node-dot graph-svg-enhanced" />
              <circle cx={node.x} cy={node.y} r={HALO_RADIUS} class="node-halo graph-svg-enhanced" />
              <text x={labelX} y={node.y - 4} text-anchor={align} class="node-label mono">
                {node.label}
              </text>
              <text x={labelX} y={node.y + 12} text-anchor={align} class="node-detail mono">
                {node.detail}
              </text>
            </g>
          );
        })}
      </svg>
    </div>
  </div>
</header>

<script>
  import type { HeroGraph3D } from '../scripts/hero-graph-3d';

  // Compartido entre boot() (lo asigna) e initEasterEgg() (lo lee) — el clic
  // sobre el avatar necesita saber si el 3D está corriendo ahora mismo.
  let activeInstance: HeroGraph3D | null = null;

  function boot() {
    const heroGraph = document.querySelector<HTMLElement>('.hero-graph');
    const mount = document.querySelector<HTMLElement>('[data-graph-3d]');
    if (!heroGraph || !mount) return;

    initEasterEgg(heroGraph);

    const raw = mount.dataset.nodes;
    if (!raw) return;
    let nodes: { x: number; y: number }[];
    try {
      nodes = JSON.parse(raw);
    } catch {
      return;
    }

    const enhancementQuery = window.matchMedia('(min-width: 901px) and (prefers-reduced-motion: no-preference)');
    let starting = false;
    let generation = 0;
    let webglAvailable: boolean | null = null;

    const setActive = (next: boolean) => {
      heroGraph.classList.toggle('graph-3d-active', next);
    };

    const canUseWebGL = () => {
      if (webglAvailable !== null) return webglAvailable;
      const probe = document.createElement('canvas');
      const context = probe.getContext('webgl2');
      webglAvailable = Boolean(context) && (navigator.hardwareConcurrency ?? 4) >= 4;
      context?.getExtension('WEBGL_lose_context')?.loseContext();
      return webglAvailable;
    };

    const stop = () => {
      generation += 1;
      starting = false;
      setActive(false);
      activeInstance?.dispose();
      activeInstance = null;
    };

    const start = async () => {
      if (starting || activeInstance || !enhancementQuery.matches || !canUseWebGL()) return;
      starting = true;
      const runGeneration = ++generation;

      try {
        const { initHeroGraph3D } = await import('../scripts/hero-graph-3d');
        if (runGeneration !== generation || !enhancementQuery.matches) return;

        const instance = initHeroGraph3D(
          mount,
          nodes,
          () => {
            if (runGeneration === generation && enhancementQuery.matches) setActive(true);
          },
          () => {
            if (runGeneration !== generation) return;
            setActive(false);
            activeInstance = null;
          }
        );

        if (!instance) {
          starting = false;
          return;
        }

        activeInstance = instance;
      } catch {
        if (runGeneration === generation) setActive(false);
      } finally {
        if (runGeneration === generation) starting = false;
      }
    };

    const evaluate = () => {
      if (!enhancementQuery.matches) {
        stop();
        return;
      }
      start();
    };

    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(evaluate, { timeout: 250 });
    } else {
      setTimeout(evaluate, 0);
    }

    enhancementQuery.addEventListener('change', evaluate);
    window.addEventListener('pagehide', stop);
    // Si la página se restaura desde bfcache (botón atrás/adelante), el
    // grafo quedó detenido por `pagehide` de la navegación anterior — sin
    // esto el hero se quedaría en el SVG estático para siempre.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) evaluate();
    });
  }

  /**
   * Easter egg: 5 clics seguidos (en menos de 600ms entre cada uno) sobre el
   * avatar disparan un barrido de color + giro en el grafo 3D (o su
   * respaldo en CSS si el 3D no está activo). A propósito sin affordance
   * visual — es un huevo de pascua, no un botón.
   */
  function initEasterEgg(heroGraph: HTMLElement) {
    const avatar = document.querySelector<SVGGElement>('[data-avatar-trigger]');
    if (!avatar) return;

    const CLICKS_NEEDED = 5;
    const WINDOW_MS = 600;
    const pulseDurationMs = Number(heroGraph.dataset.pulseMs) || 1400;
    let clicks = 0;
    let lastClick = 0;

    avatar.addEventListener('click', () => {
      const now = performance.now();
      if (now - lastClick > WINDOW_MS) clicks = 0;
      lastClick = now;
      clicks += 1;
      if (clicks < CLICKS_NEEDED) return;
      clicks = 0;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      if (activeInstance) {
        activeInstance.pulse();
      } else {
        heroGraph.classList.add('incident-pulse');
        setTimeout(() => heroGraph.classList.remove('incident-pulse'), pulseDurationMs);
      }

      console.log('%c◉ incidente simulado — resuelto', 'color:#5eead4;font-family:monospace');
    });
  }

  /** Visitante que regresa: flag en localStorage, sin red ni servidor —
   *  puramente cosmético, no necesita ser a prueba de manipulación. */
  function initReturningVisitor() {
    const VISITED_KEY = 'hero-visited';
    try {
      const returning = localStorage.getItem(VISITED_KEY) === '1';
      localStorage.setItem(VISITED_KEY, '1');
      if (returning) {
        const chip = document.querySelector<HTMLElement>('[data-returning-chip]');
        if (chip) chip.hidden = false;
      }
    } catch {
      // Storage bloqueado/privado — se ve como primera visita siempre, sin romper nada.
    }
  }

  boot();
  initReturningVisitor();
</script>

<style define:vars={{ drawDuration: `${DRAW_DURATION}s`, pulseDuration: `${PULSE_DURATION}s` }}>
  .hero {
    padding-top: 160px;
    padding-bottom: 96px;
    overflow: hidden;
    background: url('/img/hero-grid-texture.webp') center top / cover no-repeat;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(320px, 460px) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    order: 2;
  }

  .hero-graph {
    order: 1;
    position: relative;
    aspect-ratio: 460 / 600;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1.8rem + 3.2vw, 4rem);
    line-height: 1.05;
    margin: 0 0 22px;
    max-width: 14ch;
  }

  .hero-sub {
    font-size: clamp(1.02rem, 0.96rem + 0.3vw, 1.2rem);
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 34px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .visit-chip {
    margin-top: 12px;
  }

  /* [hidden] por sí solo puede perder contra .chip { display: inline-flex }
     (misma especificidad, gana la hoja de estilos del autor sobre la del
     user-agent) — ver el mismo patrón ya usado en .post-card[hidden]. */
  .visit-chip[hidden] {
    display: none;
  }

  .graph-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: 2;
  }

  .graph-3d {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 160ms;
  }

  .hero-graph.graph-3d-active .graph-3d {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .graph-3d :global(.graph-3d-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .graph-svg-enhanced {
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-graph.graph-3d-active .graph-svg-enhanced {
    opacity: 0;
  }

  .hero-graph.graph-3d-active .node-halo {
    animation: none;
  }

  .edge {
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
    opacity: 0.55;
    stroke-dashoffset: 200;
    animation: draw var(--drawDuration) ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .root-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-dot {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-halo {
    fill: none;
    stroke: var(--accent-dim);
    stroke-width: 1;
    animation: pulse 3s ease-in-out infinite;
  }

  .node-label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 500;
  }

  .root-label {
    fill: var(--text-dim);
    font-size: 12px;
  }

  .node-detail {
    fill: var(--text-faint);
    font-size: 10.5px;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      r: 15;
    }
    50% {
      opacity: 0;
      r: 24;
    }
  }

  /* Easter egg (ver <script>): respaldo en CSS puro para cuando el grafo 3D
     no está activo — mismo barrido de color (accent → warn → danger →
     accent) que hace hero-graph-3d.ts con las materiales de three.js. */
  @keyframes incidentPulse {
    0%, 100% {
      stroke: var(--accent);
    }
    25% {
      stroke: var(--warn);
    }
    50% {
      stroke: var(--danger);
    }
    75% {
      stroke: var(--warn);
    }
  }

  .hero-graph.incident-pulse .node-dot {
    animation: incidentPulse var(--pulseDuration) ease-in-out;
  }

  .hero-graph.incident-pulse .edge {
    animation: incidentPulse var(--pulseDuration) ease-in-out;
  }

  .hero-graph.incident-pulse .node-halo {
    animation: pulse 3s ease-in-out infinite, incidentPulse var(--pulseDuration) ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .edge {
      animation: none;
      stroke-dashoffset: 0;
    }
    .node-halo {
      animation: none;
      opacity: 0;
    }
    .graph-3d {
      display: none;
    }
    /* El JS ya evita agregar .incident-pulse bajo reduced-motion, pero estas
       reglas tienen más especificidad que las de arriba — sin este override
       explícito, un .incident-pulse forzado igual animaría. */
    .hero-graph.incident-pulse .node-dot,
    .hero-graph.incident-pulse .edge,
    .hero-graph.incident-pulse .node-halo {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 120px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-graph {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
