---
import { hero, capabilityNodes, meta } from '../data/content';

const root = { x: 110, y: 300 };
const radius = 250;
const angles = [-70, -35, 0, 35, 70];
const nodes = capabilityNodes.map((node, i) => {
  const rad = (angles[i] * Math.PI) / 180;
  return {
    ...node,
    x: root.x + radius * Math.cos(rad),
    y: root.y + radius * Math.sin(rad),
  };
});
---

<header id="top" class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy reveal">
      <h1 class="hero-title">{hero.headline}</h1>
      <p class="hero-sub">{hero.subheadline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
      <p class="hero-meta mono">
        <span class="status-dot" aria-hidden="true"></span>
        {meta.location} · uptime desde 2023
      </p>
    </div>

    <div class="hero-graph reveal" aria-hidden="true">
      <svg viewBox="0 0 460 600" class="graph-svg" role="img" aria-label="Mapa de topología de capacidades de Gabriel Barrientos">
        <defs>
          <clipPath id="avatarClip">
            <circle cx={root.x} cy={root.y} r="46" />
          </clipPath>
        </defs>

        {nodes.map((node, i) => (
          <line
            x1={root.x}
            y1={root.y}
            x2={node.x}
            y2={node.y}
            class="edge"
            style={`--delay: ${i * 0.15}s`}
          />
        ))}

        <image
          href="/img/hero-portrait.webp"
          x={root.x - 46}
          y={root.y - 46}
          width="92"
          height="92"
          preserveAspectRatio="xMidYMid slice"
          clip-path="url(#avatarClip)"
        />
        <circle cx={root.x} cy={root.y} r="46" class="root-ring" />
        <text x={root.x} y={root.y + 74} text-anchor="middle" class="node-label root-label mono">
          {meta.handle}
        </text>

        {nodes.map((node) => {
          const align = node.x > root.x + 40 ? 'start' : node.x < root.x - 40 ? 'end' : 'middle';
          const labelX = node.x + (align === 'start' ? 16 : align === 'end' ? -16 : 0);
          return (
            <g class="node">
              <circle cx={node.x} cy={node.y} r="8" class="node-dot" />
              <circle cx={node.x} cy={node.y} r="15" class="node-halo" />
              <text x={labelX} y={node.y - 4} text-anchor={align} class="node-label mono">
                {node.label}
              </text>
              <text x={labelX} y={node.y + 12} text-anchor={align} class="node-detail mono">
                {node.detail}
              </text>
            </g>
          );
        })}
      </svg>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-top: 160px;
    padding-bottom: 96px;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(320px, 460px) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    order: 2;
  }

  .hero-graph {
    order: 1;
  }

  .hero-title {
    font-size: clamp(2.4rem, 1.8rem + 3.2vw, 4rem);
    line-height: 1.05;
    margin: 0 0 22px;
    max-width: 14ch;
  }

  .hero-sub {
    font-size: clamp(1.02rem, 0.96rem + 0.3vw, 1.2rem);
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 34px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .graph-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .edge {
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-dasharray: 6 4;
    opacity: 0.55;
    stroke-dashoffset: 200;
    animation: draw 1.6s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .root-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-dot {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .node-halo {
    fill: none;
    stroke: var(--accent-dim);
    stroke-width: 1;
    animation: pulse 3s ease-in-out infinite;
  }

  .node-label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 500;
  }

  .root-label {
    fill: var(--text-dim);
    font-size: 12px;
  }

  .node-detail {
    fill: var(--text-faint);
    font-size: 10.5px;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      r: 15;
    }
    50% {
      opacity: 0;
      r: 24;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge {
      animation: none;
      stroke-dashoffset: 0;
    }
    .node-halo {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 120px;
    }
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-graph {
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
