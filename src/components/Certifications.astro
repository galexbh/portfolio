---
import { getCertifications } from '../lib/keystatic-content';

const certifications = await getCertifications();
---

<section id="certifications">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Certificaciones</h2>
    </div>

    <ul class="cert-list reveal">
      {certifications.map((c) => (
        <li>
          <span class="status-dot" aria-hidden="true"></span>
          <span class="cert-name">{c.name}</span>
          <span class="cert-validity mono">{c.validity}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cert-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 780px;
    border-top: 1px solid var(--line);
  }

  .cert-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .cert-name {
    flex: 1;
    font-size: 14.5px;
  }

  .cert-validity {
    font-size: 12px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .cert-list li {
      flex-wrap: wrap;
    }
  }
</style>
