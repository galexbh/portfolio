---
import { about } from '../data/content';
---

<section id="about">
  <div class="wrap about-grid">
    <div class="reveal">
      <div class="section-head">
        <h2>Sobre mí</h2>
      </div>
      <p class="lead">{about.paragraphs[0]}</p>
      <p class="lead-sub">{about.paragraphs[1]}</p>

      <ul class="vertientes">
        {about.vertientes.map((v) => (
          <li>
            <span class="v-label mono">{v.label}</span>
            <span class="v-detail">{v.detail}</span>
          </li>
        ))}
      </ul>

      <p class="closing">{about.closing}</p>

      <span class="badge mono">
        <span class="status-dot" aria-hidden="true"></span>
        {about.regulatedBadge}
      </span>
    </div>
  </div>
</section>

<style>
  .about-grid {
    max-width: 820px;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text);
    margin: 0 0 8px;
  }

  .lead-sub {
    color: var(--text-dim);
    margin: 0 0 24px;
  }

  .vertientes {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .vertientes li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .v-label {
    color: var(--accent);
    font-size: 13px;
  }

  .v-detail {
    color: var(--text-dim);
    font-size: 14.5px;
  }

  .closing {
    color: var(--text-dim);
    margin-bottom: 28px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 12px;
    color: var(--text-dim);
  }

  @media (max-width: 600px) {
    .vertientes li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
