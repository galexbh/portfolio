---
import { contact } from '../data/content';
---

<section id="contact">
  <div class="wrap contact-grid reveal">
    <div>
      <h2>Hablemos.</h2>
      <p class="contact-sub">
        ¿Buscas SRE con experiencia real en banca regulada? Escríbeme.
      </p>
    </div>

    <div class="terminal card">
      <div class="terminal-bar">
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-dot"></span>
        <span class="terminal-title mono">contact.sh</span>
      </div>
      <pre class="terminal-body mono"><code>$ ping {contact.githubHandle}
node root reachable, 0% loss

<a href={`mailto:${contact.email}`}>→ email  {contact.email}</a>
<a href={contact.github} target="_blank" rel="noopener noreferrer">→ github {contact.githubHandle}</a><span class="terminal-disabled">→ cv      próximamente</span></code></pre>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 460px);
    gap: 40px;
    align-items: center;
  }

  .contact-sub {
    color: var(--text-dim);
    max-width: 40ch;
    margin-top: 14px;
  }

  .terminal {
    padding: 0;
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-elevated-2);
  }

  .terminal-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .terminal-title {
    margin-left: 8px;
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .terminal-body {
    margin: 0;
    padding: 22px 20px;
    font-size: 13.5px;
    line-height: 2;
    color: var(--text-dim);
    white-space: pre-wrap;
  }

  .terminal-body a {
    display: block;
    color: var(--accent);
    text-decoration: none;
  }

  .terminal-body a:hover {
    text-decoration: underline;
  }

  .terminal-disabled {
    display: block;
    color: var(--text-faint);
  }

  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
