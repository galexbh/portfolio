---
import { getExperience } from '../lib/keystatic-content';

const experience = await getExperience();
---

<section id="experience">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Experiencia</h2>
    </div>

    <ol class="timeline">
      {experience.map((role, i) => (
        <li class:list={['entry', 'reveal', { current: role.current }]}>
          <div class="entry-marker">
            <span class:list={['status-dot', { resolved: !role.current }]} aria-hidden="true"></span>
            {i < experience.length - 1 && <span class="entry-line" aria-hidden="true"></span>}
          </div>
          <div class="entry-body">
            <div class="entry-head">
              <h3>{role.role}</h3>
              <span class="entry-period mono">{role.period}</span>
            </div>
            <p class="entry-company mono">{role.company} · {role.location}</p>
            <ul class="entry-bullets">
              {role.bullets.map((b) => <li>{b}</li>)}
            </ul>
            {role.metrics && (
              <div class="entry-metrics">
                {role.metrics.map((m) => (
                  <span class="metric mono">{m}</span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 780px;
  }

  .entry {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 24px;
  }

  .entry-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
  }

  .entry-line {
    flex: 1;
    width: 1px;
    background: var(--line-strong);
    margin-top: 8px;
  }

  .entry-body {
    padding-bottom: 44px;
  }

  .entry.current .entry-body h3 {
    color: var(--accent);
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .entry-head h3 {
    font-size: 1.15rem;
  }

  .entry-period {
    font-size: 12px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .entry-company {
    font-size: 12.5px;
    color: var(--text-dim);
    margin: 0 0 16px;
  }

  .entry-bullets {
    margin: 0;
    padding-left: 18px;
    color: var(--text-dim);
    font-size: 14.5px;
    display: grid;
    gap: 8px;
  }

  .entry-metrics {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  .metric {
    font-size: 12px;
    color: var(--accent);
    border: 1px solid var(--line-strong);
    background: var(--accent-dim);
    padding: 5px 10px;
    border-radius: 4px;
  }
</style>
