---
import { DocumentRenderer } from '@keystatic/core/renderer';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPosts, getPost, postCategoryLabels } from '../../lib/keystatic-content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getPost(slug!);

if (!post) {
  return Astro.redirect('/blog');
}

const body = await post.body();
const DEFAULT_COVER = '/img/blog/blog-cover-default.webp';
const coverSrc = post.cover ?? DEFAULT_COVER;

function formatDate(iso: string) {
  const [year, month, day] = iso.split('-').map(Number);
  const date = new Date(Date.UTC(year, (month ?? 1) - 1, day ?? 1));
  return date.toLocaleDateString('es-HN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
}
---

<Base title={`${post.title} — Blog — Gabriel Barrientos`} description={post.excerpt} image={coverSrc}>
  <Nav />
  <main>
    <article class="post">
      <div class="wrap post-wrap">
        <a class="back-link mono" href="/blog">← volver al blog</a>

        <header class="post-head">
          <div class="post-meta">
            <span class:list={['chip', 'post-chip', { 'post-chip-personal': post.category === 'personal' }]}>
              {postCategoryLabels[post.category] ?? post.category}
            </span>
            <p class="post-date mono">{formatDate(post.date)}</p>
          </div>
          <h1 class="post-title">{post.title}</h1>
        </header>

        <img class="post-cover" src={coverSrc} alt="" />

        <div class="prose">
          <DocumentRenderer document={body} />
        </div>

        <footer class="post-foot">
          <a class="btn btn-ghost" href="/blog">← volver al blog</a>
          <a class="btn btn-ghost" href="/">Inicio</a>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .post {
    padding-top: 160px;
  }

  .post-wrap {
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    font-size: 12.5px;
    color: var(--text-dim);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-head {
    margin-bottom: 24px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .post-chip {
    font-size: 10.5px;
    padding: 3px 9px;
    color: var(--accent);
    border-color: rgba(94, 234, 212, 0.35);
  }

  .post-chip-personal {
    color: var(--accent-strong);
    border-color: rgba(34, 211, 238, 0.35);
  }

  .post-date {
    font-size: 12px;
    color: var(--text-faint);
    margin: 0;
  }

  .post-title {
    font-size: clamp(1.8rem, 1.5rem + 1.6vw, 2.6rem);
    line-height: 1.1;
    margin: 0;
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
    margin: 32px 0;
  }

  .post-foot {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .post {
      padding-top: 120px;
    }
  }
</style>
